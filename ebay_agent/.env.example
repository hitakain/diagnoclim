# Identifiants eBay Developer (gratuits sur developer.ebay.com)
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_MARKETPLACE_ID=EBAY_FR

# Rempli automatiquement par `ebay-agent init` apres l'autorisation utilisateur (User Access Token)
EBAY_REFRESH_TOKEN=

# Merchant location key eBay (creee une fois via l'API Inventory) pour les offres
EBAY_MERCHANT_LOCATION_KEY=

# Optionnel : point de terminaison Ollama local pour ameliorer titres/descriptions (gratuit, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
